{
  "name": "server",
  "version": "1.0.0",
  "description": "server for trade sentinel",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "npm run test:prices",
    "test:prices": "npm run typecheck:scripts && ts-node scripts/test-price-engine.ts",
    "test:ws": "npm run typecheck:scripts && ts-node scripts/test-ws-protocol.ts",
    "test:limits": "npm run typecheck:scripts && ts-node scripts/test-ws-limits.ts",
    "smoke:prices": "npm run typecheck:scripts && ts-node scripts/smoke-price-engine.ts",
    "check:dist": "npm run build && git diff --exit-code -- dist && test -z \"$(git ls-files --others --exclude-standard -- dist)\""
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TradeSentinel/TradeSentinel.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TradeSentinel/TradeSentinel/issues"
  },
  "homepage": "https://github.com/TradeSentinel/TradeSentinel#readme",
  "dependencies": {
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.4.0",
    "nodemailer": "^7.0.3",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
